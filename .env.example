# Application
APP_ENV=development
LOG_LEVEL=INFO

# MySQL
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_DATABASE=ecommerce_copy_inspection
MYSQL_USER=app
MYSQL_PASSWORD=change-me-for-local-development
MYSQL_ROOT_PASSWORD=change-me-root-for-local-development
MYSQL_TEST_DATABASE=ecommerce_copy_inspection_test

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Elasticsearch
ELASTICSEARCH_URL=http://127.0.0.1:9200
ELASTICSEARCH_INDEX_PREFIX=food_rules

# BGE Cloud API
BGE_API_BASE_URL=
BGE_API_KEY=
BGE_EMBEDDING_MODEL=BAAI/bge-m3
BGE_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
