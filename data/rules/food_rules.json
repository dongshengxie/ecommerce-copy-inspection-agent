    "rule_id": "food_claim_001",
    "version": "1.1.0",
    "category": "食品",
    "field_scope": ["title", "selling_points", "description", "marketing_description"],
    "issue_type": "医疗功效宣称",
    "risk_level": "high",
    "rule_strength": "strong",
    "rule_text": "普通食品文案不得明示或暗示疾病治疗效果。",
    "bad_examples": ["治疗失眠", "降血糖", "失眠克星"],
    "rewrite_hint": "改为客观描述配料、口味、规格或食用场景。",
    "status": "enabled",
    "effective_at": "2026-08-21T00:00:00Z"
  },
